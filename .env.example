# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=generate-a-new-key-for-your-machine
DJANGO_DEBUG=True

DB_NAME=tb_screening
DB_USER=tb_app
DB_PASSWORD=set-your-own-database-password
DB_HOST=localhost
DB_PORT=5432

# --- Google sign-in -------------------------------------------------------
# Created in the Google Cloud Console under APIs & Services > Credentials, as
# an OAuth 2.0 Client ID of type "Web application". The authorised redirect URI
# must be exactly:
#     http://localhost:8000/accounts/google/login/callback/
# Leave both blank to run without sign-in; the gate then reports the provider
# as unconfigured and the Django admin remains the only way in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft, for an institution running Microsoft 365. Registered in the
# Azure portal under App registrations, with the redirect URI
#     http://localhost:8000/accounts/microsoft/login/callback/
# Leave blank to offer Google and the email code only. MICROSOFT_TENANT is
# 'common' for any account, or a tenant id to restrict to one organisation.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Sending the sign-in codes. With no EMAIL_HOST the messages are printed to
# the server console, which is enough to sign in during development and
# means a deployment that forgets to configure mail logs rather than
# silently failing.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TB Screening <no-reply@example.org>

# Whether anyone with a working email address may create an account. True
# suits a demonstration: a visitor registers with any address they can read,
# and the six-digit code proves they control the inbox. A deployment holding
# real patient records should set this False and use the allowlist below.
SIGN_IN_OPEN_REGISTRATION=True

# Who may sign in. Comma separated, case insensitive. An empty allowlist
# admits anyone, which is the default and is what open registration implies.
# A deployment holding clinical records should set both this and
# SIGN_IN_OPEN_REGISTRATION=False.
SIGN_IN_ALLOWED_EMAILS=
SIGN_IN_ALLOWED_DOMAINS=

# --- Deployment --------------------------------------------------------------
# Set in the hosting platform, not here. Listed so the required configuration is
# visible in one place.
#
# A hosted database hands out one connection string instead of five values. When
# DATABASE_URL is set it replaces the DB_* settings above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# The host terminates TLS and forwards plain HTTP, so Django has to be told to
# trust the forwarded protocol or it builds http:// callback URLs and Google
# refuses the sign-in.
# DJANGO_BEHIND_PROXY=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-space.hf.space
# DJANGO_ALLOWED_HOSTS=your-space.hf.space
#
# Names the django.contrib.sites row that allauth builds callback URLs from.
# DJANGO_SITE_DOMAIN=your-space.hf.space
