# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=generate-a-new-key-for-your-machine
DJANGO_DEBUG=True

DB_NAME=tb_screening
DB_USER=tb_app
DB_PASSWORD=set-your-own-database-password
DB_HOST=localhost
DB_PORT=5432

# --- Google sign-in -------------------------------------------------------
# Created in the Google Cloud Console under APIs & Services > Credentials, as
# an OAuth 2.0 Client ID of type "Web application". The authorised redirect URI
# must be exactly:
#     http://localhost:8000/accounts/google/login/callback/
# Leave both blank to run without sign-in; the gate then reports the provider
# as unconfigured and the Django admin remains the only way in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Who may sign in. Comma separated, case insensitive. An empty allowlist
# admits any Google account, which is acceptable only for a local
# demonstration; a deployment holding clinical records must set at least one.
SIGN_IN_ALLOWED_EMAILS=
SIGN_IN_ALLOWED_DOMAINS=

# --- Deployment --------------------------------------------------------------
# Set in the hosting platform, not here. Listed so the required configuration is
# visible in one place.
#
# A hosted database hands out one connection string instead of five values. When
# DATABASE_URL is set it replaces the DB_* settings above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# The host terminates TLS and forwards plain HTTP, so Django has to be told to
# trust the forwarded protocol or it builds http:// callback URLs and Google
# refuses the sign-in.
# DJANGO_BEHIND_PROXY=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-space.hf.space
# DJANGO_ALLOWED_HOSTS=your-space.hf.space
#
# Names the django.contrib.sites row that allauth builds callback URLs from.
# DJANGO_SITE_DOMAIN=your-space.hf.space
