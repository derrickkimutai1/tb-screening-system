# Keep the build context small and the image free of things it must not carry.

.git
.github
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Secrets. These must arrive from the environment, never from the image.
.env
*.env

# The datasets are hundreds of megabytes and the container never reads them;
# it serves the trained model, which is in ml/models.
data/
ml/models/checkpoints/
ml/notebooks/
gradcam_samples/

# Uploads and generated overlays from local use.
media/
staticfiles/

docs/
lecturer-docs/
